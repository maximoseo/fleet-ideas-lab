# Fleet Ideas Lab — environment variables (names only; values live in Vercel env / secure vault)
# Generated from `envradar` scan. Keep in sync when adding env usage.

# ── Auth (required) ──────────────────────────────────────────────
DASHBOARD_AUTH_SECRET=        # 32+ char session-signing secret
DASHBOARD_AUTH_USERNAME=      # operator login
DASHBOARD_AUTH_PASSWORD=      # operator password
TURNSTILE_SECRET_KEY=         # Cloudflare Turnstile (optional; when set, login requires widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Ops: probes / sync / alerts (P0) ─────────────────────────────
CRON_SECRET=                  # Vercel cron bearer (auto-sent by cron)
APP_TOKEN=                    # first-party Android app token (feed + login channel)
APP_TOKEN_PREVIOUS=           # rotation grace (optional)
TELEGRAM_NOTIFY64_TOKEN=      # @Notificationsnew64Bot — break alerts
TELEGRAM_NOTIFY64_CHAT=       # target chat id
VERCEL_READ_TOKEN=            # Vercel API read token for /api/fleet/sync drift

# ── Supabase persistence (P1) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server-only; tables fil_*, RLS-locked

# ── LLM / generation ─────────────────────────────────────────────
V0_API_KEY=                   # v0 (scaffold generation + Ask-AI)
V0_MODEL=                     # default model override (optional)
PERPLEXITY_API_KEY=           # research (optional)
FIRECRAWL_API_KEY=            # page extraction fallback (optional)
LOVART_API_KEY=               # image gen (optional)
LOVART_SK=

# ── Misc ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=         # e.g. https://fleet-ideas-lab.maximo-seo.ai
TELEGRAM_BOT_TOKEN=           # legacy notify route (fleet/notify)
TELEGRAM_NOTIFY64_TOKEN_CODING=
